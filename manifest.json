{
  "manifest_version": 3,
  "name": "JIRA Bug Report Formatter",
  "version": "1.2.0",
  "description": "Streamline JIRA bug reporting by auto-inserting structured templates",
  "permissions": [
    "storage",
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_title": "JIRA Bug Report Formatter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/side-panel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  }
}
